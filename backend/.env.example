# Server
PORT=8787

# JWT (change in production)
JWT_SECRET=replace-me-with-a-long-random-string
JWT_TTL_DAYS=14

DB_PROVIDER=postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?pgbouncer=true
# LLM provider: gemini | mock
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3-flash-preview
LLM_API_KEY=replace-me
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
LLM_BUDGET_MAX_CALLS_PER_RUN=500

# Email provider: console | resend | smtp
EMAIL_PROVIDER=console
RESEND_API_KEY=
# NetEase enterprise mail usually uses smtp.qiye.163.com. Confirm the port and
# encryption mode shown in your NetEase admin console before production use.
SMTP_HOST=smtp.qiye.163.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=hi@dopa.aurahk.me
SMTP_PASSWORD=replace-with-mailbox-client-password
EMAIL_FROM="DopaMine <hi@dopa.aurahk.me>"
EMAIL_REPLY_TO="hi@dopa.aurahk.me"
FRONTEND_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:8787

# Auth
ADMIN_SECRET=dev-secret-change-me
AUTH_CODE_TTL_MIN=10
AUTH_CODE_RATE_LIMIT_PER_HOUR=5
INVITE_REQUIRED=true

# Scheduler
SCHEDULER_ENABLED=false
SCHEDULER_TRIGGER="Wednesday 19:00"

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
