# Server
PORT=8787

# JWT (change in production)
JWT_SECRET=replace-me-with-a-long-random-string
JWT_TTL_DAYS=14

DB_PROVIDER=postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?pgbouncer=true
# LLM provider: gemini | mock
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3-flash-preview
LLM_API_KEY=replace-me
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
LLM_BUDGET_MAX_CALLS_PER_RUN=500

# Email provider: console | resend
EMAIL_PROVIDER=resend
RESEND_API_KEY=replace-me
EMAIL_FROM="DopaMine <noreply@example.com>"
FRONTEND_URL=https://www.aurahk.me
API_PUBLIC_URL=https://thrumming-island-597.fly.dev

# Auth
ADMIN_SECRET=dev-secret-change-me
AUTH_CODE_TTL_MIN=10
AUTH_CODE_RATE_LIMIT_PER_HOUR=5
INVITE_REQUIRED=true

CORS_ORIGINS=*
